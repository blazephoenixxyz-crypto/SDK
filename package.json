{
  "name": "@blazephoenix/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for BlazePhoenix — the on-chain DEX aggregator. Quote, build, verify and execute swaps 100% on YOUR RPC (no API in the read path, no key, no endpoints shipped). Versioned deployments (1.x live, 2.x Core/Hub/Solver/Quoter/Router). Base, Ethereum, Optimism, Arbitrum, Robinhood Chain.",
  "keywords": [
    "blazephoenix",
    "bzpx",
    "dex",
    "dex-aggregator",
    "swap",
    "defi",
    "base",
    "ethereum",
    "optimism",
    "arbitrum",
    "telegram-bot",
    "viem",
    "byo-rpc",
    "self-hosted",
    "on-chain-quoter",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blazephoenixxyz-crypto/SDK.git"
  },
  "homepage": "https://blazephoenix.xyz/?tab=api",
  "bugs": "https://github.com/blazephoenixxyz-crypto/SDK/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "tsx scripts/test.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "gen:abis": "node scripts/gen-abis.mjs ../Blaze-Phoenix-Dex"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "viem": "^2.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
